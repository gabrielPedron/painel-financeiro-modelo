# Copie para .env.local e preencha VOCÊ MESMO, no editor. Este arquivo nunca vai para o Git
# (o .gitignore ignora *.local) e ninguém além de você deve ver o conteúdo.

# Senha do banco: a que o painel do Supabase gerou ao criar o projeto.
# Se perdeu: Project Settings > Database > Reset database password.
SUPABASE_DB_PASSWORD=

# Chave secreta: painel do Supabase > Project Settings > API Keys > Secret keys (começa com sb_secret_).
SUPABASE_SERVICE_ROLE_KEY=
