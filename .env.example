# Copie para .env e preencha. Só entram valores PÚBLICOS aqui (eles vão para o navegador).
# Onde achar: painel do Supabase > Project Settings > API Keys / Data API.
# A chave secreta (sb_secret_...) NUNCA entra neste arquivo: ela vai em .env.local.
SUPABASE_PROJECT_ID="SEU_PROJECT_REF"
SUPABASE_URL="https://SEU_PROJECT_REF.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
VITE_SUPABASE_PROJECT_ID="SEU_PROJECT_REF"
VITE_SUPABASE_URL="https://SEU_PROJECT_REF.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
